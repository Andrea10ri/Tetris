<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox alignment="CENTER" prefHeight=".0" prefWidth="900.0" spacing="20" style="-fx-background-color: radial-gradient(center 50% 50%, radius 80%, #1E3970, #03051C);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.tetris.CONTROLLER.Game_Controller">


    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- SINISTRA: board principale del giocatore -->
    <VBox alignment="TOP_CENTER" spacing="10">

        <!-- Timer e fase -->
        <HBox alignment="CENTER" spacing="15">
            <Label fx:id="lblTimer" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="tmr" textFill="WHITE" />
            <Label fx:id="lblPhase" style="-fx-font-size: 14px;" text="phase" textFill="WHITE" />
        </HBox>


        <Canvas fx:id="mainBoard" height="600" width="300" />

        <!-- Score e linee -->
        <HBox alignment="CENTER" spacing="20">
            <VBox alignment="CENTER" prefHeight="95.0" prefWidth="49.0">
                <Label style="-fx-font-size: 10px;" text="SCORE" textFill="WHITE" />
                <Label fx:id="lblScore" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="0" textFill="WHITE" />
            </VBox>
            <VBox alignment="CENTER">
                <Label style="-fx-font-size: 10px;" text="NEXT" textFill="WHITE" />
                <Canvas fx:id="nextPiece" height="80" width="80" />
            </VBox>
        </HBox>


        <!--effetti attivati-->
        <HBox fx:id="activeEffectsContainer" alignment="CENTER" spacing="8" />
        <Label fx:id="lblEffects" style="-fx-font-size: 11px; -fx-text-fill: orange;" text="" />

    </VBox>

    <VBox fx:id="rankingContainer" alignment="TOP_CENTER" prefHeight="783.0" prefWidth="246.0" spacing="8" style="-fx-padding: 20;">
        <Label style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 14px;" text="RANKING" />
        <VBox fx:id="rankingList" spacing="5" />
    </VBox>

    <!-- DESTRA: board avversari -->
    <HBox fx:id="opponentsContainer" alignment="TOP_CENTER" fillHeight="false" prefHeight="773.0" prefWidth="488.0" spacing="10" HBox.hgrow="ALWAYS" />

</HBox>
