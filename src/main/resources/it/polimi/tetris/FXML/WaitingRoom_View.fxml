<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.tetris.CONTROLLER.WaitingRoom_Controller">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>


    <Label fx:id="lblTitle" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Waiting Room" />


    <HBox fx:id="playersContainer" alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
        <!--i pannelli verranno aggiunti dinamicamente dal controller -->
    </HBox>


    <HBox alignment="CENTER" spacing="10">
        <Label text="Choose a color :" />
        <ComboBox fx:id="cmbColor" prefWidth="120" />
        <Button fx:id="btnReady" onAction="#onReadyClick" prefWidth="100" text="READY" />
    </HBox>

    <!-- Stato -->
    <Label fx:id="lblStatus" text="Waiting for other players..." />

</VBox>
